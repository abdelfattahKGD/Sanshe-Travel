{"groups":[{"id":"g1","ar":"التحية والترحيب","en":"Greetings & Welcome"},{"id":"g2","ar":"التعارف","en":"Introductions"},{"id":"g3","ar":"عبارات المجاملة","en":"Polite Expressions"},{"id":"g4","ar":"السؤال والإجابة","en":"Asking & Answering"},{"id":"g5","ar":"نعم ولا والموافقة","en":"Yes, No & Agreement"},{"id":"g6","ar":"بدء الكلام ومتابعته","en":"Starting & Continuing Talk"},{"id":"g7","ar":"الضمائر والإشارة","en":"Pronouns & Pointing"},{"id":"g8","ar":"التوديع والتمنيات","en":"Farewells & Wishes"}],"words":[{"g":"g1","lv":"A1","en":"hello","pos":"interj","ar":"مرحبًا","ex":"Hello, everyone, welcome back!","id":"t1w001"},{"g":"g1","lv":"A1","en":"hi","pos":"interj","ar":"أهلًا","ex":"Hi, Sara, come in.","id":"t1w002"},{"g":"g1","lv":"A1","en":"good morning","pos":"phrase","ar":"صباح الخير","ex":"Good morning, teacher!","id":"t1w003"},{"g":"g1","lv":"A1","en":"good afternoon","pos":"phrase","ar":"مساء الخير (بعد الظهر)","ex":"Good afternoon, Mr. Adams.","id":"t1w004"},{"g":"g1","lv":"A1","en":"good evening","pos":"phrase","ar":"مساء الخير","ex":"Good evening, ladies and gentlemen.","id":"t1w005"},{"g":"g1","lv":"A1","en":"good night","pos":"phrase","ar":"تصبح على خير","ex":"Good night, sleep well.","id":"t1w006"},{"g":"g1","lv":"A1","en":"welcome","pos":"interj","ar":"أهلًا وسهلًا","ex":"Welcome to our home.","id":"t1w007"},{"g":"g1","lv":"A2","en":"greeting","pos":"n","ar":"تحية","ex":"She gave me a warm greeting.","id":"t1w008"},{"g":"g1","lv":"A2","en":"wave","pos":"v","ar":"يلوّح بيده","ex":"He waved at his neighbor.","id":"t1w009"},{"g":"g1","lv":"A2","en":"shake hands","pos":"phrase","ar":"يصافح","ex":"They shook hands and smiled.","id":"t1w010"},{"g":"g1","lv":"A1","en":"meet","pos":"v","ar":"يقابل / يتعرّف على","ex":"I want you to meet Sam.","id":"t1w011"},{"g":"g1","lv":"A1","en":"again","pos":"adv","ar":"مرة أخرى","ex":"Please say that again.","id":"t1w012"},{"g":"g2","lv":"A1","en":"name","pos":"n","ar":"اسم","ex":"My name is Omar.","id":"t1w013"},{"g":"g2","lv":"A2","en":"introduce","pos":"v","ar":"يُقدّم (شخصًا) / يعرّف","ex":"Let me introduce my sister.","id":"t1w014"},{"g":"g2","lv":"A1","en":"call","pos":"v","ar":"يُنادي / يُسمّي","ex":"Everyone calls him Mo.","id":"t1w015"},{"g":"g2","lv":"A1","en":"from","pos":"prep","ar":"من (الأصل)","ex":"I'm from Cairo.","id":"t1w016"},{"g":"g2","lv":"A1","en":"live","pos":"v","ar":"يعيش / يسكن","ex":"We live in Giza.","id":"t1w017"},{"g":"g2","lv":"A2","en":"age","pos":"n","ar":"عمر","ex":"Age is just a number.","id":"t1w018"},{"g":"g2","lv":"A1","en":"old","pos":"adj","ar":"كبير في السن / عمره","ex":"How old are you?","id":"t1w019"},{"g":"g2","lv":"A1","en":"country","pos":"n","ar":"بلد","ex":"Which country are you from?","id":"t1w020"},{"g":"g2","lv":"A1","en":"city","pos":"n","ar":"مدينة","ex":"I love this city.","id":"t1w021"},{"g":"g2","lv":"B1","en":"nationality","pos":"n","ar":"جنسية","ex":"What is your nationality?","id":"t1w022"},{"g":"g2","lv":"A1","en":"speak","pos":"v","ar":"يتكلم","ex":"Do you speak English?","id":"t1w023"},{"g":"g2","lv":"A1","en":"language","pos":"n","ar":"لغة","ex":"English is a global language.","id":"t1w024"},{"g":"g2","lv":"A2","en":"born","pos":"adj","ar":"مولود","ex":"I was born in 1995.","id":"t1w025"},{"g":"g3","lv":"A1","en":"please","pos":"adv","ar":"من فضلك","ex":"Help me, please.","id":"t1w026"},{"g":"g3","lv":"A1","en":"thanks","pos":"interj","ar":"شكرًا","ex":"Thanks for your help.","id":"t1w027"},{"g":"g3","lv":"A1","en":"thank","pos":"v","ar":"يشكر","ex":"I thank you very much.","id":"t1w028"},{"g":"g3","lv":"A1","en":"sorry","pos":"adj","ar":"آسف","ex":"I'm sorry I'm late.","id":"t1w029"},{"g":"g3","lv":"A1","en":"excuse me","pos":"phrase","ar":"عفوًا / لو سمحت","ex":"Excuse me, where is the exit?","id":"t1w030"},{"g":"g3","lv":"A2","en":"pardon","pos":"interj","ar":"عفوًا؟ (أعد من فضلك)","ex":"Pardon? I didn't hear you.","id":"t1w031"},{"g":"g3","lv":"A2","en":"polite","pos":"adj","ar":"مهذّب","ex":"He is always very polite.","id":"t1w032"},{"g":"g3","lv":"A2","en":"kind","pos":"adj","ar":"لطيف / طيب القلب","ex":"She is kind to everyone.","id":"t1w033"},{"g":"g3","lv":"B1","en":"appreciate","pos":"v","ar":"يقدّر / يُثمّن","ex":"I really appreciate your help.","id":"t1w034"},{"g":"g3","lv":"B1","en":"apologize","pos":"v","ar":"يعتذر","ex":"I apologize for the delay.","id":"t1w035"},{"g":"g3","lv":"B1","en":"forgive","pos":"v","ar":"يسامح","ex":"Please forgive my mistake.","id":"t1w036"},{"g":"g3","lv":"B1","en":"mind","pos":"v","ar":"يمانع / يهتم","ex":"Do you mind closing the window?","id":"t1w037"},{"g":"g4","lv":"A1","en":"question","pos":"n","ar":"سؤال","ex":"I have a quick question.","id":"t1w038"},{"g":"g4","lv":"A1","en":"answer","pos":"n","ar":"إجابة","ex":"Do you know the answer?","id":"t1w039"},{"g":"g4","lv":"A1","en":"ask","pos":"v","ar":"يسأل / يطلب","ex":"Can I ask something?","id":"t1w040"},{"g":"g4","lv":"A2","en":"reply","pos":"v","ar":"يردّ","ex":"She didn't reply to my message.","id":"t1w041"},{"g":"g4","lv":"A1","en":"what","pos":"pron","ar":"ماذا / ما","ex":"What time is it?","id":"t1w042"},{"g":"g4","lv":"A1","en":"where","pos":"adv","ar":"أين","ex":"Where do you live?","id":"t1w043"},{"g":"g4","lv":"A1","en":"when","pos":"adv","ar":"متى","ex":"When does the class start?","id":"t1w044"},{"g":"g4","lv":"A1","en":"why","pos":"adv","ar":"لماذا","ex":"Why are you late?","id":"t1w045"},{"g":"g4","lv":"A1","en":"who","pos":"pron","ar":"مَن","ex":"Who is that man?","id":"t1w046"},{"g":"g4","lv":"A1","en":"how","pos":"adv","ar":"كيف","ex":"How does this work?","id":"t1w047"},{"g":"g4","lv":"A1","en":"which","pos":"det","ar":"أي / أيّ واحد","ex":"Which one do you want?","id":"t1w048"},{"g":"g4","lv":"A2","en":"mean","pos":"v","ar":"يعني","ex":"What does this word mean?","id":"t1w049"},{"g":"g4","lv":"A1","en":"understand","pos":"v","ar":"يفهم","ex":"I don't understand the question.","id":"t1w050"},{"g":"g4","lv":"A2","en":"repeat","pos":"v","ar":"يعيد / يكرّر","ex":"Could you repeat that, please?","id":"t1w051"},{"g":"g5","lv":"A1","en":"yes","pos":"interj","ar":"نعم","ex":"Yes, I would love to.","id":"t1w052"},{"g":"g5","lv":"A1","en":"no","pos":"interj","ar":"لا","ex":"No, thank you.","id":"t1w053"},{"g":"g5","lv":"A1","en":"maybe","pos":"adv","ar":"ربما","ex":"Maybe we can go tomorrow.","id":"t1w054"},{"g":"g5","lv":"A1","en":"sure","pos":"adj","ar":"متأكد / بالتأكيد","ex":"Are you sure about this?","id":"t1w055"},{"g":"g5","lv":"A1","en":"of course","pos":"phrase","ar":"بالطبع","ex":"Of course, I can help.","id":"t1w056"},{"g":"g5","lv":"A1","en":"okay","pos":"adj","ar":"حسنًا / تمام","ex":"Okay, let's get started.","id":"t1w057"},{"g":"g5","lv":"A1","en":"right","pos":"adj","ar":"صحيح / على حق","ex":"You are absolutely right.","id":"t1w058"},{"g":"g5","lv":"A1","en":"wrong","pos":"adj","ar":"خطأ","ex":"Sorry, that's the wrong answer.","id":"t1w059"},{"g":"g5","lv":"A2","en":"agree","pos":"v","ar":"يوافق","ex":"I totally agree with you.","id":"t1w060"},{"g":"g5","lv":"B1","en":"disagree","pos":"v","ar":"يختلف / لا يوافق","ex":"I disagree with that idea.","id":"t1w061"},{"g":"g5","lv":"A2","en":"true","pos":"adj","ar":"صحيح / حقيقي","ex":"That's not true at all.","id":"t1w062"},{"g":"g5","lv":"B1","en":"probably","pos":"adv","ar":"على الأرجح","ex":"She will probably call later.","id":"t1w063"},{"g":"g6","lv":"A1","en":"talk","pos":"v","ar":"يتحدث","ex":"Can we talk for a minute?","id":"t1w064"},{"g":"g6","lv":"A1","en":"tell","pos":"v","ar":"يُخبر / يقول لـ","ex":"Tell me what happened.","id":"t1w065"},{"g":"g6","lv":"A1","en":"say","pos":"v","ar":"يقول","ex":"What did you say?","id":"t1w066"},{"g":"g6","lv":"A2","en":"chat","pos":"v","ar":"يتجاذب أطراف الحديث","ex":"We chat every evening.","id":"t1w067"},{"g":"g6","lv":"A1","en":"listen","pos":"v","ar":"يستمع","ex":"Please listen to me carefully.","id":"t1w068"},{"g":"g6","lv":"A1","en":"hear","pos":"v","ar":"يسمع","ex":"I can't hear you well.","id":"t1w069"},{"g":"g6","lv":"A1","en":"wait","pos":"v","ar":"ينتظر","ex":"Wait here for a moment.","id":"t1w070"},{"g":"g6","lv":"A1","en":"start","pos":"v","ar":"يبدأ","ex":"Let's start with the basics.","id":"t1w071"},{"g":"g6","lv":"A2","en":"continue","pos":"v","ar":"يكمل / يواصل","ex":"Please continue your story.","id":"t1w072"},{"g":"g6","lv":"A2","en":"explain","pos":"v","ar":"يشرح","ex":"Can you explain it again?","id":"t1w073"},{"g":"g6","lv":"B1","en":"mention","pos":"v","ar":"يذكر","ex":"He didn't mention the price.","id":"t1w074"},{"g":"g6","lv":"B1","en":"interrupt","pos":"v","ar":"يقاطع","ex":"Sorry to interrupt you.","id":"t1w075"},{"g":"g6","lv":"A2","en":"by the way","pos":"phrase","ar":"على فكرة","ex":"By the way, where is Ali?","id":"t1w076"},{"g":"g7","lv":"A1","en":"I","pos":"pron","ar":"أنا","ex":"I am ready.","id":"t1w077"},{"g":"g7","lv":"A1","en":"you","pos":"pron","ar":"أنت / أنتم","ex":"You look very happy.","id":"t1w078"},{"g":"g7","lv":"A1","en":"he","pos":"pron","ar":"هو","ex":"He works near here.","id":"t1w079"},{"g":"g7","lv":"A1","en":"she","pos":"pron","ar":"هي","ex":"She speaks three languages.","id":"t1w080"},{"g":"g7","lv":"A1","en":"we","pos":"pron","ar":"نحن","ex":"We are good friends.","id":"t1w081"},{"g":"g7","lv":"A1","en":"they","pos":"pron","ar":"هم","ex":"They live next door.","id":"t1w082"},{"g":"g7","lv":"A1","en":"it","pos":"pron","ar":"هو / هي (لغير العاقل)","ex":"It is a nice day.","id":"t1w083"},{"g":"g7","lv":"A1","en":"my","pos":"det","ar":"ـي (ملكية المتكلم)","ex":"This is my phone.","id":"t1w084"},{"g":"g7","lv":"A1","en":"your","pos":"det","ar":"ـك (ملكية المخاطب)","ex":"Is this your bag?","id":"t1w085"},{"g":"g7","lv":"A1","en":"this","pos":"det","ar":"هذا / هذه","ex":"This is very useful.","id":"t1w086"},{"g":"g7","lv":"A1","en":"that","pos":"det","ar":"ذلك / تلك","ex":"That sounds like a plan.","id":"t1w087"},{"g":"g7","lv":"A1","en":"here","pos":"adv","ar":"هنا","ex":"Come here, please.","id":"t1w088"},{"g":"g8","lv":"A1","en":"goodbye","pos":"interj","ar":"مع السلامة","ex":"Goodbye, and thank you!","id":"t1w089"},{"g":"g8","lv":"A1","en":"bye","pos":"interj","ar":"إلى اللقاء (غير رسمي)","ex":"Bye! See you tomorrow.","id":"t1w090"},{"g":"g8","lv":"A2","en":"leave","pos":"v","ar":"يغادر","ex":"I have to leave now.","id":"t1w091"},{"g":"g8","lv":"A1","en":"later","pos":"adv","ar":"لاحقًا","ex":"I'll call you later.","id":"t1w092"},{"g":"g8","lv":"A1","en":"soon","pos":"adv","ar":"قريبًا","ex":"We'll meet again soon.","id":"t1w093"},{"g":"g8","lv":"A2","en":"care","pos":"n","ar":"رعاية / اهتمام","ex":"Take care of yourself.","id":"t1w094"},{"g":"g8","lv":"A2","en":"luck","pos":"n","ar":"حظ","ex":"Good luck on your exam.","id":"t1w095"},{"g":"g8","lv":"A2","en":"wish","pos":"v","ar":"يتمنّى","ex":"I wish you all the best.","id":"t1w096"},{"g":"g8","lv":"A1","en":"hope","pos":"v","ar":"يأمل","ex":"I hope you feel better.","id":"t1w097"},{"g":"g8","lv":"A2","en":"congratulations","pos":"interj","ar":"مبروك / تهانينا","ex":"Congratulations on your new job!","id":"t1w098"},{"g":"g8","lv":"A2","en":"safe","pos":"adj","ar":"آمن / بسلام","ex":"Have a safe trip!","id":"t1w099"},{"g":"g8","lv":"A1","en":"see you","pos":"phrase","ar":"أراك لاحقًا","ex":"See you at the party.","id":"t1w100"}],"sentences":[{"g":"g1","lv":"A1","en":"Hi! How are you doing?","ar":"أهلًا! كيف حالك؟","id":"t1s001"},{"g":"g1","lv":"A1","en":"Good morning! Did you sleep well?","ar":"صباح الخير! هل نمت جيدًا؟","id":"t1s002"},{"g":"g1","lv":"A1","en":"Hello, everyone. Thanks for coming today.","ar":"مرحبًا بالجميع. شكرًا لحضوركم اليوم.","id":"t1s003"},{"g":"g1","lv":"A1","en":"Welcome! Please come in and sit down.","ar":"أهلًا وسهلًا! تفضّل بالدخول والجلوس.","id":"t1s004"},{"g":"g1","lv":"A2","en":"Long time no see! How have you been?","ar":"مر وقت طويل! كيف كانت أحوالك؟","id":"t1s005"},{"g":"g1","lv":"A1","en":"It's so good to see you again.","ar":"سعدت جدًا برؤيتك مرة أخرى.","id":"t1s006"},{"g":"g1","lv":"A2","en":"Good evening. Do you have a reservation?","ar":"مساء الخير. هل لديك حجز؟","id":"t1s007"},{"g":"g1","lv":"A2","en":"Hey, what's up? Anything new?","ar":"أهلًا، ما الأخبار؟ هل من جديد؟","id":"t1s008"},{"g":"g1","lv":"A2","en":"How is your family doing?","ar":"كيف حال عائلتك؟","id":"t1s009"},{"g":"g1","lv":"B1","en":"Thank you for having me over.","ar":"شكرًا على استضافتك لي.","id":"t1s010"},{"g":"g1","lv":"B1","en":"Please, make yourself at home.","ar":"تفضّل، اعتبر نفسك في بيتك.","id":"t1s011"},{"g":"g1","lv":"A1","en":"Good night, and sleep well.","ar":"تصبح على خير ونم جيدًا.","id":"t1s012"},{"g":"g2","lv":"A1","en":"My name is Omar. Nice to meet you.","ar":"اسمي عمر. تشرّفت بمعرفتك.","id":"t1s013"},{"g":"g2","lv":"A1","en":"Hi there! What's your name, please?","ar":"أهلًا بك! ما اسمك من فضلك؟","id":"t1s014"},{"g":"g2","lv":"A2","en":"Let me introduce my friend, Sara.","ar":"اسمح لي أن أعرّفك على صديقتي سارة.","id":"t1s015"},{"g":"g2","lv":"A2","en":"I'm from Egypt, but I live in Dubai.","ar":"أنا من مصر لكنني أعيش في دبي.","id":"t1s016"},{"g":"g2","lv":"A2","en":"Where are you from originally?","ar":"من أين أنت في الأصل؟","id":"t1s017"},{"g":"g2","lv":"A2","en":"How old are you, by the way?","ar":"كم عمرك، على فكرة؟","id":"t1s018"},{"g":"g2","lv":"A1","en":"I am twenty-five years old.","ar":"عمري خمسة وعشرون عامًا.","id":"t1s019"},{"g":"g2","lv":"A1","en":"Do you speak English or Arabic?","ar":"هل تتحدث الإنجليزية أم العربية؟","id":"t1s020"},{"g":"g2","lv":"A1","en":"I speak a little English.","ar":"أتحدث القليل من الإنجليزية.","id":"t1s021"},{"g":"g2","lv":"A2","en":"Are you new in this city?","ar":"هل أنت جديد في هذه المدينة؟","id":"t1s022"},{"g":"g2","lv":"A2","en":"This is my first time here.","ar":"هذه أول مرة لي هنا.","id":"t1s023"},{"g":"g2","lv":"A2","en":"Please call me Mo. Everyone does.","ar":"ناديني مو من فضلك. الجميع يفعل ذلك.","id":"t1s024"},{"g":"g2","lv":"B1","en":"I'm glad we finally met.","ar":"يسعدني أننا التقينا أخيرًا.","id":"t1s025"},{"g":"g3","lv":"A1","en":"Thank you so much for your help.","ar":"شكرًا جزيلًا على مساعدتك.","id":"t1s026"},{"g":"g3","lv":"A2","en":"Thanks, I really appreciate it.","ar":"شكرًا، أقدّر ذلك حقًا.","id":"t1s027"},{"g":"g3","lv":"A2","en":"You're welcome. It was my pleasure.","ar":"عفوًا، كان ذلك من دواعي سروري.","id":"t1s028"},{"g":"g3","lv":"A1","en":"I'm sorry, it was my mistake.","ar":"آسف، كان ذلك خطئي.","id":"t1s029"},{"g":"g3","lv":"A1","en":"Excuse me, could you help me?","ar":"لو سمحت، هل يمكنك مساعدتي؟","id":"t1s030"},{"g":"g3","lv":"A1","en":"Sorry, could you say that again?","ar":"آسف، هل يمكنك قول ذلك مرة أخرى؟","id":"t1s031"},{"g":"g3","lv":"A2","en":"Sorry to bother you, but I'm lost.","ar":"آسف على الإزعاج، لكنني تائه.","id":"t1s032"},{"g":"g3","lv":"B1","en":"Would you mind opening the window?","ar":"هل تمانع في فتح النافذة؟","id":"t1s033"},{"g":"g3","lv":"A2","en":"No problem at all. Don't worry about it.","ar":"لا مشكلة إطلاقًا. لا تقلق بشأن ذلك.","id":"t1s034"},{"g":"g3","lv":"B1","en":"Please accept my apologies for the delay.","ar":"يرجى قبول اعتذاري عن التأخير.","id":"t1s035"},{"g":"g3","lv":"A2","en":"That's very kind of you.","ar":"هذا لطف كبير منك.","id":"t1s036"},{"g":"g3","lv":"A2","en":"Please, go ahead. After you.","ar":"تفضّل، بعدك.","id":"t1s037"},{"g":"g4","lv":"A1","en":"Can I ask you a quick question?","ar":"هل يمكنني أن أسألك سؤالًا سريعًا؟","id":"t1s038"},{"g":"g4","lv":"A1","en":"What does this word mean?","ar":"ماذا تعني هذه الكلمة؟","id":"t1s039"},{"g":"g4","lv":"A2","en":"I don't understand. Could you explain?","ar":"لا أفهم. هل يمكنك أن تشرح؟","id":"t1s040"},{"g":"g4","lv":"A1","en":"Where is the nearest bathroom?","ar":"أين أقرب دورة مياه؟","id":"t1s041"},{"g":"g4","lv":"A1","en":"What time does it start?","ar":"متى يبدأ ذلك؟","id":"t1s042"},{"g":"g4","lv":"A1","en":"Why are you so late today?","ar":"لماذا تأخّرت هكذا اليوم؟","id":"t1s043"},{"g":"g4","lv":"A1","en":"Who is the man over there?","ar":"مَن ذلك الرجل هناك؟","id":"t1s044"},{"g":"g4","lv":"A1","en":"How do you say this in English?","ar":"كيف تقول هذا بالإنجليزية؟","id":"t1s045"},{"g":"g4","lv":"A2","en":"Which one do you prefer?","ar":"أيّهما تفضّل؟","id":"t1s046"},{"g":"g4","lv":"A2","en":"I'm not sure. Let me check.","ar":"لست متأكدًا. دعني أتحقق.","id":"t1s047"},{"g":"g4","lv":"A1","en":"I don't know the answer yet.","ar":"لا أعرف الإجابة بعد.","id":"t1s048"},{"g":"g4","lv":"A2","en":"That is a really good question.","ar":"هذا سؤال جيد حقًا.","id":"t1s049"},{"g":"g4","lv":"A2","en":"Could you repeat the question, please?","ar":"هل يمكنك إعادة السؤال من فضلك؟","id":"t1s050"},{"g":"g5","lv":"A1","en":"Yes, of course. I'd be happy to.","ar":"نعم بالطبع. يسعدني ذلك.","id":"t1s051"},{"g":"g5","lv":"A1","en":"No, thank you. I'm fine.","ar":"لا، شكرًا. أنا بخير.","id":"t1s052"},{"g":"g5","lv":"A2","en":"Maybe, but I'm not sure yet.","ar":"ربما، لكنني لست متأكدًا بعد.","id":"t1s053"},{"g":"g5","lv":"A2","en":"I totally agree with you.","ar":"أتفق معك تمامًا.","id":"t1s054"},{"g":"g5","lv":"B1","en":"I'm afraid I disagree with that.","ar":"أخشى أنني لا أتفق مع ذلك.","id":"t1s055"},{"g":"g5","lv":"A2","en":"You're absolutely right about that.","ar":"أنت محق تمامًا في ذلك.","id":"t1s056"},{"g":"g5","lv":"A2","en":"That's not true. Check again.","ar":"هذا غير صحيح. تحقق مرة أخرى.","id":"t1s057"},{"g":"g5","lv":"A1","en":"Sure, no problem. I'll do it.","ar":"بالتأكيد، لا مشكلة. سأفعل ذلك.","id":"t1s058"},{"g":"g5","lv":"A2","en":"Okay, that sounds like a plan.","ar":"حسنًا، هذه خطة جيدة.","id":"t1s059"},{"g":"g5","lv":"A2","en":"I think you're wrong this time.","ar":"أظن أنك مخطئ هذه المرة.","id":"t1s060"},{"g":"g5","lv":"B1","en":"It probably won't rain today.","ar":"على الأرجح لن تمطر اليوم.","id":"t1s061"},{"g":"g5","lv":"B1","en":"Exactly! That's what I meant.","ar":"بالضبط! هذا ما قصدته.","id":"t1s062"},{"g":"g6","lv":"A1","en":"Can we talk for a minute?","ar":"هل يمكننا التحدث لدقيقة؟","id":"t1s063"},{"g":"g6","lv":"A2","en":"Let me tell you what happened.","ar":"دعني أخبرك بما حدث.","id":"t1s064"},{"g":"g6","lv":"A2","en":"Please listen to me carefully.","ar":"رجاءً استمع إليّ بعناية.","id":"t1s065"},{"g":"g6","lv":"A1","en":"I can't hear you very well.","ar":"لا أسمعك جيدًا.","id":"t1s066"},{"g":"g6","lv":"A2","en":"Wait a moment. I'll be right back.","ar":"انتظر لحظة. سأعود حالًا.","id":"t1s067"},{"g":"g6","lv":"A2","en":"Let's start with the basics.","ar":"لنبدأ بالأساسيات.","id":"t1s068"},{"g":"g6","lv":"A2","en":"Please, continue. I am listening.","ar":"تفضّل أكمل. أنا أستمع.","id":"t1s069"},{"g":"g6","lv":"B1","en":"Sorry to interrupt, but it's urgent.","ar":"آسف للمقاطعة، لكن الأمر عاجل.","id":"t1s070"},{"g":"g6","lv":"A2","en":"By the way, did you call Ali?","ar":"على فكرة، هل اتصلت بعلي؟","id":"t1s071"},{"g":"g6","lv":"A2","en":"Can you explain that in simple words?","ar":"هل يمكنك شرح ذلك بكلمات بسيطة؟","id":"t1s072"},{"g":"g6","lv":"B1","en":"As I mentioned, the plan has changed.","ar":"كما ذكرت، الخطة تغيّرت.","id":"t1s073"},{"g":"g6","lv":"A2","en":"We should chat more often.","ar":"ينبغي أن نتحدث أكثر.","id":"t1s074"},{"g":"g6","lv":"B1","en":"Anyway, let's get back to work.","ar":"على أي حال، لنعد إلى العمل.","id":"t1s075"},{"g":"g7","lv":"A1","en":"I am ready. Are you ready?","ar":"أنا جاهز. هل أنت جاهز؟","id":"t1s076"},{"g":"g7","lv":"A1","en":"This is my phone, not yours.","ar":"هذا هاتفي وليس هاتفك.","id":"t1s077"},{"g":"g7","lv":"A1","en":"Is that your bag over there?","ar":"هل تلك حقيبتك هناك؟","id":"t1s078"},{"g":"g7","lv":"A2","en":"We have been good friends for years.","ar":"نحن أصدقاء جيدون منذ سنوات.","id":"t1s079"},{"g":"g7","lv":"A1","en":"They live next door to us.","ar":"هم يسكنون بجوارنا.","id":"t1s080"},{"g":"g7","lv":"A2","en":"He works hard, and she studies a lot.","ar":"هو يعمل بجد وهي تذاكر كثيرًا.","id":"t1s081"},{"g":"g7","lv":"A1","en":"It is a beautiful day today.","ar":"الجو جميل اليوم.","id":"t1s082"},{"g":"g7","lv":"A1","en":"Come here and look at this.","ar":"تعال إلى هنا وانظر إلى هذا.","id":"t1s083"},{"g":"g7","lv":"A1","en":"Put it there, not here.","ar":"ضعه هناك وليس هنا.","id":"t1s084"},{"g":"g7","lv":"A2","en":"That looks interesting. What is it?","ar":"يبدو ذلك مثيرًا للاهتمام. ما هو؟","id":"t1s085"},{"g":"g7","lv":"A1","en":"Excuse me, is this seat free?","ar":"لو سمحت، هل هذا المقعد خالٍ؟","id":"t1s086"},{"g":"g7","lv":"A2","en":"These are mine, and those are yours.","ar":"هذه لي وتلك لك.","id":"t1s087"},{"g":"g8","lv":"A1","en":"Goodbye! It was nice talking to you.","ar":"إلى اللقاء! كان من الجميل التحدث إليك.","id":"t1s088"},{"g":"g8","lv":"A1","en":"Bye for now! See you tomorrow.","ar":"إلى اللقاء الآن! أراك غدًا.","id":"t1s089"},{"g":"g8","lv":"A1","en":"I have to leave now.","ar":"يجب أن أغادر الآن.","id":"t1s090"},{"g":"g8","lv":"A2","en":"I'll call you later tonight.","ar":"سأتصل بك لاحقًا الليلة.","id":"t1s091"},{"g":"g8","lv":"A1","en":"See you soon. Take care!","ar":"أراك قريبًا. اعتنِ بنفسك!","id":"t1s092"},{"g":"g8","lv":"A2","en":"Good luck with your exam!","ar":"بالتوفيق في امتحانك!","id":"t1s093"},{"g":"g8","lv":"A2","en":"Have a safe trip back home.","ar":"رحلة آمنة في العودة إلى المنزل.","id":"t1s094"},{"g":"g8","lv":"A2","en":"Congratulations on your new job!","ar":"مبروك على وظيفتك الجديدة!","id":"t1s095"},{"g":"g8","lv":"A2","en":"I wish you all the best.","ar":"أتمنى لك كل التوفيق.","id":"t1s096"},{"g":"g8","lv":"A2","en":"I hope you feel better soon.","ar":"آمل أن تتحسن قريبًا.","id":"t1s097"},{"g":"g8","lv":"A2","en":"Have a great weekend, everyone!","ar":"عطلة أسبوع رائعة للجميع!","id":"t1s098"},{"g":"g8","lv":"A2","en":"Thanks again, and have a nice day.","ar":"شكرًا مرة أخرى، ويوم سعيد.","id":"t1s099"},{"g":"g8","lv":"B1","en":"Let's keep in touch, okay?","ar":"لنبقَ على تواصل، اتفقنا؟","id":"t1s100"}]}